{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixMirror",
  "version": "0.1.0",
  "identifier": "com.pixmirror.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PixMirror",
        "width": 880,
        "height": 560,
        "minWidth": 760,
        "minHeight": 500,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/scrcpy",
      "binaries/adb"
    ],
    "resources": [
      "binaries/*.dll",
      "binaries/scrcpy-server",
      "binaries/icon.png"
    ]
  }
}
